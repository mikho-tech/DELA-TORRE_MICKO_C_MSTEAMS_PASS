import math

print ("=====Task 1: Angle Explorer=====")

angle = 234

rad = math.radians(angle)
sin = math.sin(rad)
cos = math.cos(rad)
tan = math.tan(rad)

print ("Angle in Degrees -" , angle)
print ("Angle in Radiant is -" , round(rad, 4))
print ("Sin -" , round(sin, 4))
print ("Cos -" , round(cos, 4))
print ("Tan -" , round(tan, 4))
